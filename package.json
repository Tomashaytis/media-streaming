{
    "name": "media-streaming",
    "version": "1.0.0",
    "description": "Simple client-server application for media streaming",
    "main": "media-server/index.js",
    "type": "commonjs",
    "scripts": {
        "start-server": "node media-server/index.js",
        "dev-server": "nodemon media-server/index.js",
        "build-client": "cd stream-client && npm run build",
        "dev-client": "cd stream-client && npm start",
        "install-all": "cd media-server && npm install && cd ../stream-client && npm install",
        "client": "cd stream-client && npm start",
        "server": "node media-server/index.js",
        "dev-all": "concurrently \"npm run dev-server\" \"npm run dev-client\""
    },
    "keywords": [
        "streaming",
        "webrtc",
        "media",
        "video"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "cors": "^2.8.5",
        "express": "^4.18.2",
        "ws": "^8.14.2"
    },
    "devDependencies": {
        "concurrently": "^7.6.0",
        "nodemon": "^3.1.11"
    }
}